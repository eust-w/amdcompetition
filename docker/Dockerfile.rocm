FROM rocm/pytorch:rocm6.4.1_ubuntu22.04_py3.10_pytorch_release_2.6.0

ARG GENESIS_COMMIT=a253ec5c043807cb0f785fd5e5adc865b248e34a
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYOPENGL_PLATFORM=egl

RUN apt-get update \
    && apt-get install -y --no-install-recommends git libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir \
    "git+https://github.com/Genesis-Embodied-AI/genesis-world.git@${GENESIS_COMMIT}" \
    libigl==2.5.1

WORKDIR /workspace
COPY pyproject.toml README.md LICENSE THIRD_PARTY_NOTICES.md ./
COPY src ./src
COPY configs ./configs
COPY scripts ./scripts
RUN python -m pip install --no-cache-dir -e .

ENTRYPOINT ["roborecover"]
CMD ["check-rocm"]

